import React, { useEffect, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "./ui/card";
import { Badge } from "./ui/badge";
import { Button } from "./ui/button";
import { RefreshCw } from "lucide-react";
import { useToast } from "../hooks/use-toast";
import Produto from "../models/Produto";

import React, { useEffect, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "./ui/card";
import { Badge } from "./ui/badge";
import { Button } from "./ui/button";
import { RefreshCw } from "lucide-react";
import { useToast } from "../hooks/use-toast";
import Produto from "../models/Produto";

const ListarProdutos: React.FC = () => {
  const { toast } = useToast();
  const [produtos, setProdutos] = useState<Produto[]>([]);
  const [carregando, setCarregando] = useState(false);

  const fetchProdutos = async () => {
    setCarregando(true);
    try {
      const response = await fetch("http://localhost:5011/api/produto/listar");
      if (!response.ok) {
        throw new Error("Erro ao carregar produtos");
      }
      const data = await response.json();
      setProdutos(Array.isArray(data) ? data : []);
    } catch (error: any) {
      toast({
        title: "Erro",
        description: error.message || "Erro ao carregar produtos",
        variant: "destructive",
      });
    } finally {
      setCarregando(false);
    }
  };
  const { toast } = useToast();
  const [produtos, setProdutos] = useState<Produto[]>([]);
  const [carregando, setCarregando] = useState(false);

  const fetchProdutos = async () => {
    setCarregando(true);
    try {
      const response = await fetch("http://localhost:5011/api/produto/listar");
      if (!response.ok) {
        throw new Error("Erro ao carregar produtos");
      }
      const data = await response.json();
      setProdutos(Array.isArray(data) ? data : []);
    } catch (error: any) {
      toast({
        title: "Erro",
        description: error.message || "Erro ao carregar produtos",
        variant: "destructive",
      });
    } finally {
      setCarregando(false);
    }
  };

  useEffect(() => {
    fetchProdutos();
  }, []);

  return (
    <div className="container mx-auto px-4 py-8">
      <div className="mb-8 flex items-center justify-between">
        <h2 className="text-4xl font-bold text-primary text-shadow">
          Produtos Disponíveis
        </h2>
        <Button
          variant="gradient"
          onClick={fetchProdutos}
          disabled={carregando}
          className="flex items-center gap-2"
        >
          <RefreshCw className={`${carregando ? 'animate-spin' : ''}`} />
          {carregando ? 'Carregando...' : 'Atualizar'}
        </Button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {produtos.map((produto, index) => (
          <Card
            key={produto.id}
            className="group bg-card hover:border-primary transition-all duration-300 hover:card-shadow-hover animate-fade-up"
            style={{
              animationDelay: `${index * 50}ms`,
            }}
          >
            <CardHeader>
              <CardTitle className="text-xl font-bold text-primary">
                {produto.nome}
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="flex items-center justify-between">
                <span className="text-muted-foreground">Preço:</span>
                <Badge variant="success">
                  R$ {produto.preco.toFixed(2)}
                </Badge>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-muted-foreground">Quantidade:</span>
                <Badge variant="warning">
                  {produto.quantidade} un.
                </Badge>
              </div>
              <p className="text-muted-foreground italic">
                {produto.descricao}
              </p>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  );
    fetchProdutos();
  }, []);

  return (
    <div className="container mx-auto px-4 py-8">
      <div className="mb-8 flex items-center justify-between">
        <h2 className="text-4xl font-bold text-primary text-shadow">
          Produtos Disponíveis
        </h2>
        <Button
          variant="gradient"
          onClick={fetchProdutos}
          disabled={carregando}
          className="flex items-center gap-2"
        >
          <RefreshCw className={`${carregando ? 'animate-spin' : ''}`} />
          {carregando ? 'Carregando...' : 'Atualizar'}
        </Button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {produtos.map((produto, index) => (
          <Card
            key={produto.id}
            className="group bg-card hover:border-primary transition-all duration-300 hover:card-shadow-hover animate-fade-up"
            style={{
              animationDelay: `${index * 50}ms`,
            }}
          >
            <CardHeader>
              <CardTitle className="text-xl font-bold text-primary">
                {produto.nome}
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="flex items-center justify-between">
                <span className="text-muted-foreground">Preço:</span>
                <Badge variant="success">
                  R$ {produto.preco.toFixed(2)}
                </Badge>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-muted-foreground">Quantidade:</span>
                <Badge variant="warning">
                  {produto.quantidade} un.
                </Badge>
              </div>
              <p className="text-muted-foreground italic">
                {produto.descricao}
              </p>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  );
};
    };

    fetchProdutos();
  }, []);

  if (carregando) {
    return <div>Carregando...</div>;
  }

  return (
    <div className="listar-produtos">
      <h1>Lista de Produtos</h1>
      <div className="produtos-container">
        {produtos.map((produto) => (
          <div key={produto.id} className="produto-card">
            <h2>{produto.nome}</h2>
            <p>Preço: R$ {produto.preco.toFixed(2)}</p>
            <p>Descrição: {produto.descricao}</p>
          </div>
        ))}
      </div>
    </div>
  );
};

export default ListarProdutos;
